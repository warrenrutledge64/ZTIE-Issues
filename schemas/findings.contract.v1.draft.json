{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ztie.internal/schemas/findings.contract.v1.draft.json",
  "title": "ZTIE Forensic -> Hub findings/telemetry data contract (v1 DRAFT / design-only)",
  "description": "DESIGN-ONLY sketch (RD-017). Rich process-attributed detonation+static findings record crossing the SAME RD-013 gate as the intake contract, enriching the same intake_id record. NOT yet implemented (Phase 2/3/4). Same gate rules: allow-list additionalProperties:false everywhere, typed+bounded, fail-closed, verdict Hub-owned/never imported, no raw payload/executable field. Two projections of one causal evidence set: capabilities[] (MITRE ATT&CK inventory, View 1) and ports[] (port-indexed, View 2).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "intake_id",
    "sha256",
    "detonation",
    "processes",
    "ports",
    "capabilities"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "intake_id": {
      "description": "Binds this findings record to the intake record it enriches (upsert key).",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "detonation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ec2_instance_id",
        "started_at",
        "ended_at",
        "mapping_engine",
        "port_scope"
      ],
      "properties": {
        "ec2_instance_id": {
          "description": "The ephemeral EC2 stood up ONLY for this detonation.",
          "type": "string",
          "maxLength": 64
        },
        "ami_id": {
          "type": "string",
          "maxLength": 64
        },
        "os_flavor": {
          "type": "string",
          "enum": [
            "al2023",
            "ubuntu-22.04",
            "rhel-9"
          ]
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "ended_at": {
          "type": "string",
          "format": "date-time",
          "maxLength": 40
        },
        "torn_down": {
          "description": "Confirms the ephemeral EC2 was destroyed (hard TTL).",
          "type": "boolean"
        },
        "mapping_engine": {
          "description": "RD-017 selectable MITRE mapping engine used this run.",
          "type": "string",
          "enum": [
            "rules",
            "nova",
            "both"
          ]
        },
        "port_scope": {
          "description": "RD-017 selectable port-view scope.",
          "type": "string",
          "enum": [
            "all",
            "artifact-only"
          ]
        }
      }
    },
    "processes": {
      "description": "Process tree observed during detonation; every event references a pid here.",
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pid",
          "argv"
        ],
        "properties": {
          "pid": {
            "type": "integer",
            "minimum": 0
          },
          "ppid": {
            "type": "integer",
            "minimum": 0
          },
          "argv": {
            "description": "Command line (the 'hand' that jiggled the knob).",
            "type": "string",
            "maxLength": 4096
          },
          "exe": {
            "type": "string",
            "maxLength": 1024
          },
          "start_offset_ms": {
            "description": "ms after artifact exec that this process appeared.",
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "ports": {
      "description": "VIEW 2 - port-indexed. Queryable across a range; each port resolves to owner process + disposition + technique(s).",
      "type": "array",
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "port",
          "proto",
          "state",
          "owner_pid"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535
          },
          "proto": {
            "type": "string",
            "enum": [
              "tcp",
              "udp"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "listen",
              "connect",
              "probe",
              "closed"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "allowed",
              "denied",
              "observed"
            ]
          },
          "owner_pid": {
            "type": "integer",
            "minimum": 0
          },
          "first_seen_offset_ms": {
            "type": "integer",
            "minimum": 0
          },
          "baseline": {
            "description": "True = baseline OS port (e.g. sshd); present when port_scope=all.",
            "type": "boolean"
          },
          "remote": {
            "type": "string",
            "maxLength": 256
          },
          "attack_technique_ids": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
            }
          }
        }
      }
    },
    "network": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_pid",
          "dst"
        ],
        "properties": {
          "owner_pid": {
            "type": "integer",
            "minimum": 0
          },
          "dst": {
            "description": "dst ip:port",
            "type": "string",
            "maxLength": 256
          },
          "dns_name": {
            "type": "string",
            "maxLength": 253
          },
          "bytes_out": {
            "type": "integer",
            "minimum": 0
          },
          "disposition": {
            "type": "string",
            "enum": [
              "allowed",
              "denied",
              "observed"
            ]
          },
          "attack_technique_ids": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
            }
          }
        }
      }
    },
    "file_ops": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_pid",
          "path",
          "op"
        ],
        "properties": {
          "owner_pid": {
            "type": "integer",
            "minimum": 0
          },
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "op": {
            "type": "string",
            "enum": [
              "open",
              "read",
              "write",
              "unlink",
              "chmod",
              "exec"
            ]
          },
          "attack_technique_ids": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
            }
          }
        }
      }
    },
    "syscalls": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner_pid",
          "name"
        ],
        "properties": {
          "owner_pid": {
            "type": "integer",
            "minimum": 0
          },
          "name": {
            "type": "string",
            "maxLength": 64
          },
          "args_summary": {
            "type": "string",
            "maxLength": 512
          }
        }
      }
    },
    "capabilities": {
      "description": "VIEW 1 - MITRE ATT&CK capability inventory ('what this program CAN DO'). Each = a demonstrated technique + evidence + which engine mapped it.",
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "technique_id",
          "technique_name",
          "mapped_by"
        ],
        "properties": {
          "technique_id": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          },
          "technique_name": {
            "type": "string",
            "maxLength": 256
          },
          "tactic": {
            "type": "string",
            "maxLength": 64
          },
          "mapped_by": {
            "description": "RD-017: which engine produced this mapping.",
            "type": "string",
            "enum": [
              "rules",
              "nova"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "description": "Back-refs into processes/ports/network/file_ops/syscalls that earned this technique.",
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      }
    },
    "static_correlation": {
      "description": "Static-lane findings cross-referenced with dynamic evidence (Phase 3). Design-only shape.",
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule_id": {
            "type": "string",
            "maxLength": 128
          },
          "framework": {
            "type": "string",
            "maxLength": 64
          },
          "control_id": {
            "type": "string",
            "maxLength": 64
          },
          "confirmed_by_dynamic": {
            "type": "boolean"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "severity": {
      "description": "Rolled-up worst-case severity.",
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    }
  }
}
