#!/usr/bin/env python3
"""Repo-tracked pre-commit hook: run the governance-doc consistency gate.

Opt-in (developers point git at this directory once):

    git config core.hooksPath .githooks

It runs ``scripts/check_docs.py`` before every commit. That checker now includes
CHECK M, which fails the commit if the generated repo structure map
(``docs/REPO_MAP.md``) has drifted from the tree or if an annotation targets a
missing path. On failure it prints how to refresh the map and blocks the commit.

Skip in an emergency with ``git commit --no-verify`` (use sparingly).
"""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path


def _repo_root() -> Path:
    out = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=True,
    )
    return Path(out.stdout.strip())


def main() -> int:
    root = _repo_root()
    checker = root / "scripts" / "check_docs.py"
    if not checker.exists():
        # Nothing to enforce in this tree; let the commit through.
        return 0
    result = subprocess.run([sys.executable, str(checker)], cwd=root, check=False)
    if result.returncode != 0:
        sys.stderr.write(
            "\npre-commit: check_docs failed (see above). "
            "If CHECK M reports a stale map, run:\n"
            "  python3 scripts/gen_repo_map.py --ref main "
            "--annotations docs/repo-map.annotations.json -o docs/REPO_MAP.md\n"
            "then re-stage docs/REPO_MAP.md. Bypass with --no-verify only if you "
            "understand why.\n"
        )
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
